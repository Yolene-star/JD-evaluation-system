# Optional OpenAI-compatible provider configuration
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Set to 0 to force the deterministic local parser.
LLM_ANALYSIS_ENABLED=1
# Optional corporate/VPN proxy, for example http://127.0.0.1:7890
HTTPS_PROXY=
DATABASE_URL=sqlite:///./app.db
